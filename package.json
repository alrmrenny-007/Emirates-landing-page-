{
  "name": "emirates-landing-offline-build",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/styles.css --minify",
    "build:js": "babel src/app.jsx --out-file dist/app.js --presets @babel/preset-react",
    "dev": "npm run build && echo 'Built. Open dist/index.html in a browser.'"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
